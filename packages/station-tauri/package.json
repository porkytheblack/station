{
  "name": "station-tauri",
  "version": "2.2.0",
  "description": "Run Station as a Tauri sidecar — auto-provisioned auth, localhost-only API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "station-sidecar": "./dist/sidecar.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "station-kit": "workspace:*",
    "station-signal": "workspace:*"
  },
  "peerDependencies": {
    "station-adapter-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "station-adapter-sqlite": "workspace:*",
    "typescript": "^5.9.3"
  }
}
