{
  "name": "station-adapter-postgres",
  "version": "2.0.0",
  "description": "PostgreSQL adapter for station-signal and station-broadcast",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast.d.ts",
      "import": "./dist/broadcast.js",
      "default": "./dist/broadcast.js"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "import": "./dist/schedules.js",
      "default": "./dist/schedules.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./beacon": {
      "types": "./dist/beacon.d.ts",
      "import": "./dist/beacon.js",
      "default": "./dist/beacon.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  },
  "peerDependencies": {
    "station-signal": "workspace:*",
    "station-broadcast": "workspace:*",
    "station-schedules": "workspace:*",
    "station-beacon": "workspace:*",
    "station-env": "workspace:*"
  },
  "peerDependenciesMeta": {
    "station-schedules": {
      "optional": true
    },
    "station-beacon": {
      "optional": true
    },
    "station-env": {
      "optional": true
    }
  }
}
