{
  "name": "station-broadcast",
  "version": "3.0.0",
  "description": "Workflow orchestration for station-signal \u2014 connect signals into DAGs",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#broadcast-crypto": {
      "types": "./dist/browser-crypto.d.ts",
      "browser": "./dist/browser-crypto.js",
      "default": "crypto"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "station-signal": "workspace:*"
  },
  "dependencies": {
    "station-expressions": "workspace:*"
  },
  "devDependencies": {
    "station-signal": "workspace:*",
    "typescript": "^5.9.3",
    "@types/node": "^25.3.0"
  }
}
