{
  "name": "station-sandbox",
  "version": "2.4.0",
  "description": "Native POSIX workspaces and supervised commands for Station workers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
