FROM docker.io/library/node:22-bookworm-slim

# Build a fresh Linux toolchain. No host node_modules or native binaries are copied.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates chromium git \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global --no-audit --no-fund bun@1.3.14

RUN apt-get update && apt-get install --yes --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/station
RUN printf '%s\n' '{"private":true,"type":"module"}' > package.json \
    && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --no-audit --no-fund --save-exact \
       tsx@4.21.0 typescript@5.9.3 @types/node@25.3.0 playwright@1.63.0 node-pty@1.1.0
COPY tsconfig.base.json ./
COPY packages/station-sandbox ./packages/station-sandbox
COPY packages/station-browser-use ./packages/station-browser-use
COPY scripts/execution-linux ./scripts/execution-linux
RUN ./node_modules/.bin/tsc -p packages/station-sandbox/tsconfig.json \
    && ./node_modules/.bin/tsc -p packages/station-browser-use/tsconfig.json \
    && chmod +x scripts/execution-linux/chromium-test.sh scripts/execution-linux/check.sh \
    && chown -R node:node /opt/station

USER node
ENV HOME=/home/node
ENV TMPDIR=/tmp
# These are trusted local test pages, with browser sandbox disabled only by the
# harness wrapper. No privileged container or host container-runtime socket.
ENV STATION_TEST_CHROMIUM=/opt/station/scripts/execution-linux/chromium-test.sh
CMD ["/opt/station/scripts/execution-linux/check.sh"]
