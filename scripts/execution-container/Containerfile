# Build station-browser-use first. Use an immutable digest for the resulting image in production.
FROM docker.io/library/node:22-bookworm-slim AS runtime
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
WORKDIR /opt/station/packages/station-browser-use
RUN npm install --omit=dev --ignore-scripts playwright@1.63.0 && npx playwright install --with-deps chromium && npm cache clean --force
COPY packages/station-browser-use/dist/ ./dist/
RUN node -e 'require("node:fs").writeFileSync("package.json", JSON.stringify({type:"module"}))'
RUN chown -R node:node /home/node && chmod -R a+rX /opt/station/packages/station-browser-use/dist
USER 1000:1000
ENV HOME=/home/node
ENTRYPOINT ["/usr/local/bin/node", "/opt/station/packages/station-browser-use/dist/container-worker.js"]

# Test-only image target; no fixture server is present in the runtime target.
FROM runtime AS integration
COPY packages/station-browser-use/test/container-fixture.mjs /opt/station/container-fixture.mjs
